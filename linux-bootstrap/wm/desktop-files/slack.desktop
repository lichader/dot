[Desktop Entry]
Name=Slack
StartupWMClass=Slack
Comment=Slack Desktop
GenericName=Slack Client for Linux
Exec=env SLACK_ENABLE_WAYLAND=1 /usr/bin/slack --ozone-platform=wayland --enable-features=WaylandWindowDecorations %U
Icon=slack
Type=Application
StartupNotify=true
Categories=GNOME;GTK;Network;InstantMessaging;
MimeType=x-scheme-handler/slack;
