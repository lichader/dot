# for this to work you must configure sudo such that
# it will be able to run the command without password

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# bsp, stack or float
yabai -m config layout bsp
yabai -m config window_placement second_child

# padding
yabai -m config top_padding 5
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 10

# mouse settings
yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier alt
# left click + drag
yabai -m config mouse_action1 move
# right click + drag
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# window opacity (default: off)
# example: render all unfocused windows with 90% opacity
# yabai -m config window_opacity on
# yabai -m config active_window_opacity 1.0
# yabai -m config normal_window_opacity 0.9

#Disable specific app
global_apps="^(System Settings|Calculator|Karabiner-Elements|Finder|Archive Utility|Alfred Preferences)$"
yabai -m rule --add app="${global_apps}" manage=off

# Web browsers
yabai -m rule --add app="^(Google Chrome|Firefox Developer Edition|Google Meet)$" space=1

# Coding apps
apps="^(WezTerm|Code|Bruno)$"
yabai -m rule --add app="${apps}" space=2

# blacklist any popout windows e.g settings, plugins so they keep floating
JB_Apps='^(IntelliJ IDEA)$'
yabai -m rule --add app="${JB_Apps}" space=2 manage=off
# If `Open last project when launch` is checked, add this rule. And make sure `always show project path` is also checked.
# yabai -m rule --add app="${JB_Apps}" title=".*\[.*\].*" manage=on
yabai -m rule --add app="${JB_Apps}" title="^$"  space=2 manage=on

# space 3 and 4??
s3_apps="^(WezTerm)$"
yabai -m rule --add app="${s3_apps}" space=3

s4_apps="^(Microsoft Remote Desktop|Firefox Developer Edition|Firefox)$"
yabai -m rule --add app="${s4_apps}" space=4


# Photos apps
photo_apps="^(Photos|Lightroom Classic|Photoshop 2024|Capture One)$"
yabai -m rule --add app="${photo_apps}" space=5

# Second monitor
yabai -m rule --add app="^(Slack|WhatsApp|WeChat|Obsidian|2Do)$" space=6
yabai -m rule --add app="${Slack}" title="^$"  space=6 manage=on

# Safari - Second monitor
yabai -m rule --add app="^Safari$" space=7

# Calendar - Second monitor
yabai -m rule --add app="^(Fantastical)$" space=8
#
# Music
yabai -m rule --add app="^(Spotify)$" space=9

# focus window after active space changes, pick the first non-floating window because slack huddle window is annoying!
# yabai -m query --windows --space  | jq '[.[]|select(."is-floating"==false)][0].id'
yabai -m signal --add event=space_changed action="yabai -m window --focus \$(yabai -m query --windows --space | jq '[.[]|select(.\"is-floating\"==false)][0].id' "


# focus window after active display changes
yabai -m signal --add event=display_changed action="yabai -m window --focus \$(yabai -m query --windows --space | jq '[.[]|select(.\"is-floating\"==false)][0].id' "

# spacebar padding on top screen
SPACEBAR_HEIGHT=$(sketchybar --query bar | jq '.height')
yabai -m config external_bar all:$SPACEBAR_HEIGHT:5
